pipeline {
    agent any

    environment {
        BRANCH_FRONTEND = 'main'
        APP_DIR         = 'D:\\ICS-Projects\\apps\\food-ordering-system'
        APP_NAME        = 'food-ordering-system'
        VAULT_URL       = 'http://localhost:8200'
        VAULT_CRED_ID   = 'vault-token'
        HOME            = 'C:\\ProgramData\\Jenkins'
    }

    stages {

        // ─── Step 1: ดึงข้อมูลจาก GitHub ──────────────────────────────────────
        stage('Checkout') {
            steps {
                withVault(
                    configuration: [
                        vaultUrl: "${VAULT_URL}",
                        vaultCredentialId: "${VAULT_CRED_ID}"
                    ],
                    vaultSecrets: [[
                        path: 'secret/jenkins/github',
                        engineVersion: 2,
                        secretValues: [
                            [envVar: 'GITHUB_USER',  vaultKey: 'username'],
                            [envVar: 'GITHUB_TOKEN', vaultKey: 'token']
                        ]
                    ]]
                ) {
                    dir('src') {
                        bat """
                            git clone -b %BRANCH_FRONTEND% ^
                                https://%GITHUB_USER%:%GITHUB_TOKEN%@github.com/nateesoft/food-ordering-system.git .
                        """
                    }
                }
            }
        }

        // ─── Step 2: Install Dependencies ─────────────────────────────────────
        stage('Install') {
            steps {
                dir('src') {
                    bat "npm ci"
                }
            }
        }

        // ─── Step 3: Write Env (ต้องทำก่อน Build เพราะ NEXT_PUBLIC_* ถูก bake ตอน build) ──
        stage('Write Env') {
            steps {
                withVault(
                    configuration: [
                        vaultUrl: "${VAULT_URL}",
                        vaultCredentialId: "${VAULT_CRED_ID}"
                    ],
                    vaultSecrets: [[
                        path: 'secret/food-ordering-system/app',
                        engineVersion: 2,
                        secretValues: [
                            [envVar: 'PORT',               vaultKey: 'port'],
                            [envVar: 'NEXT_PUBLIC_API_URL', vaultKey: 'next_public_api_url']
                        ]
                    ]]
                ) {
                    bat """
                        (
                            echo PORT=%PORT%
                            echo NEXT_PUBLIC_API_URL=%NEXT_PUBLIC_API_URL%
                        ) > src\\.env.production
                    """
                }
            }
        }

        // ─── Step 4: Build ─────────────────────────────────────────────────────
        stage('Build') {
            steps {
                bat "if exist src\\.next rmdir /s /q src\\.next"
                dir('src') {
                    bat "npx next build"
                }
            }
        }

        // ─── Step 5: Deploy ────────────────────────────────────────────────────
        // standalone output มี node_modules ครบในตัว ไม่ต้อง npm ci ที่ปลายทาง
        stage('Deploy Frontend') {
            steps {
                // Stop NSSM service ก่อน เพื่อปลด file lock
                powershell """
                    nssm stop \$env:APP_NAME 2>&1 | Out-Null
                    exit 0
                """

                // robocopy exit code 0-8 = success, 9+ = error
                bat """
                    if not exist "%APP_DIR%"       mkdir "%APP_DIR%"
                    if not exist "%APP_DIR%\\logs" mkdir "%APP_DIR%\\logs"
                    robocopy src\\.next\\standalone  "%APP_DIR%"             /E /NP /NFL /NDL
                    if %ERRORLEVEL% GEQ 9 exit /B %ERRORLEVEL%
                    robocopy src\\.next\\static      "%APP_DIR%\\.next\\static" /E /NP /NFL /NDL
                    if %ERRORLEVEL% GEQ 9 exit /B %ERRORLEVEL%
                    robocopy src\\public             "%APP_DIR%\\public"     /E /NP /NFL /NDL
                    if %ERRORLEVEL% GEQ 9 exit /B %ERRORLEVEL%
                    copy /Y src\\.env.production     "%APP_DIR%\\.env.production"
                """

                // Register เป็น Windows Service ด้วย NSSM — auto-start ทุกครั้งที่ boot
                powershell """
                    \$port = ((Get-Content "\$env:APP_DIR\\.env.production" |
                        Where-Object { \$_ -match '^PORT=' }) -replace '^PORT=', '').Trim()
                    \$nodePath = (Get-Command node.exe).Source
                    nssm remove \$env:APP_NAME confirm 2>&1 | Out-Null
                    nssm install \$env:APP_NAME \$nodePath
                    nssm set \$env:APP_NAME AppParameters        "\$env:APP_DIR\\server.js"
                    nssm set \$env:APP_NAME AppDirectory         "\$env:APP_DIR"
                    nssm set \$env:APP_NAME AppEnvironmentExtra  "PORT=\$port"
                    nssm set \$env:APP_NAME AppStdout            "\$env:APP_DIR\\logs\\app.log"
                    nssm set \$env:APP_NAME AppStderr            "\$env:APP_DIR\\logs\\app.log"
                    nssm set \$env:APP_NAME Start                SERVICE_AUTO_START
                    nssm start \$env:APP_NAME
                """
                echo "Frontend deployed → http://localhost"
            }
        }

        // ─── Step 6: Health Check ──────────────────────────────────────────────
        stage('Health Check') {
            steps {
                powershell """
                    \$port = ((Get-Content "\$env:APP_DIR\\.env.production" |
                        Where-Object { \$_ -match '^PORT=' }) -replace '^PORT=', '').Trim()
                    Write-Host "PORT = '\$port'"
                    Write-Host "Polling http://localhost:\$port/food-ordering ..."

                    \$maxRetries = 12
                    \$delay      = 5
                    \$ok         = \$false

                    for (\$i = 1; \$i -le \$maxRetries; \$i++) {
                        Start-Sleep -Seconds \$delay
                        try {
                            \$res = Invoke-WebRequest -Uri "http://localhost:\$port/food-ordering" -UseBasicParsing -TimeoutSec 5
                            if (\$res.StatusCode -eq 200) {
                                Write-Host "✅ Health check passed (HTTP 200) after \$(\$i * \$delay)s"
                                \$ok = \$true
                                break
                            }
                        } catch {
                            Write-Host "Attempt \$i/\$maxRetries — not ready yet (\$(\$_.Exception.Message))"
                        }
                    }

                    if (-not \$ok) {
                        Write-Host "❌ Service did not respond after \$(\$maxRetries * \$delay)s"
                        Write-Host "--- NSSM service status ---"
                        nssm status \$env:APP_NAME 2>&1
                        Write-Host "--- App log (last 50 lines) ---"
                        \$logFile = "\$env:APP_DIR\\logs\\app.log"
                        if (Test-Path \$logFile) {
                            Get-Content \$logFile -Tail 50
                        } else {
                            Write-Host "Log file not found: \$logFile"
                        }
                        exit 1
                    }
                """
            }
        }
    }

    post {
        success {
            echo "✅ Deployment successful → http://localhost"
        }
        failure {
            powershell "nssm restart \$env:APP_NAME 2>&1 | Out-Null; exit 0"
            echo "❌ Pipeline failed — rolled back to previous process. Check the stage logs above."
        }
        always {
            cleanWs()
        }
    }
}
