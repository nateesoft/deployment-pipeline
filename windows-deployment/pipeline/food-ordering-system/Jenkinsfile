pipeline {
    agent any

    environment {
        BRANCH_FRONTEND = 'main'
        APP_DIR         = 'D:\\ICS-Projects\\apps\\food-ordering-system'
        APP_NAME        = 'food-ordering-system'
        VAULT_URL       = 'http://localhost:8200'
        VAULT_CRED_ID   = 'vault-token'
    }

    stages {

        // ─── Step 1: ดึงข้อมูลจาก GitHub ──────────────────────────────────────
        stage('Checkout') {
            steps {
                withVault(
                    configuration: [
                        vaultUrl: "${VAULT_URL}",
                        vaultCredentialId: "${VAULT_CRED_ID}"
                    ],
                    vaultSecrets: [[
                        path: 'secret/jenkins/github',
                        engineVersion: 2,
                        secretValues: [
                            [envVar: 'GITHUB_USER',  vaultKey: 'username'],
                            [envVar: 'GITHUB_TOKEN', vaultKey: 'token']
                        ]
                    ]]
                ) {
                    dir('src') {
                        bat """
                            git clone -b %BRANCH_FRONTEND% ^
                                https://%GITHUB_USER%:%GITHUB_TOKEN%@github.com/nateesoft/food-ordering-system.git .
                        """
                    }
                }
            }
        }

        // ─── Step 2: Install Dependencies ─────────────────────────────────────
        stage('Install') {
            steps {
                dir('src') {
                    bat "npm ci"
                }
            }
        }

        // ─── Step 3: Write Env (ต้องทำก่อน Build เพราะ NEXT_PUBLIC_* ถูก bake ตอน build) ──
        stage('Write Env') {
            steps {
                withVault(
                    configuration: [
                        vaultUrl: "${VAULT_URL}",
                        vaultCredentialId: "${VAULT_CRED_ID}"
                    ],
                    vaultSecrets: [[
                        path: 'secret/food-ordering-system/app',
                        engineVersion: 2,
                        secretValues: [
                            [envVar: 'PORT',               vaultKey: 'port'],
                            [envVar: 'NEXT_PUBLIC_API_URL', vaultKey: 'next_public_api_url']
                        ]
                    ]]
                ) {
                    bat """
                        (
                            echo PORT=%PORT%
                            echo NEXT_PUBLIC_API_URL=%NEXT_PUBLIC_API_URL%
                        ) > src\\.env.production
                    """
                }
            }
        }

        // ─── Step 4: Build ─────────────────────────────────────────────────────
        stage('Build') {
            steps {
                bat "if exist src\\.next rmdir /s /q src\\.next"
                dir('src') {
                    bat "npx next build"
                }
            }
        }

        // ─── Step 5: Deploy ────────────────────────────────────────────────────
        stage('Deploy Frontend') {
            steps {
                // คัดลอกไฟล์ที่ build แล้วไปยัง APP_DIR
                bat """
                    if not exist "%APP_DIR%"       mkdir "%APP_DIR%"
                    if not exist "%APP_DIR%\\logs" mkdir "%APP_DIR%\\logs"
                    xcopy /E /I /Y src\\.next         "%APP_DIR%\\.next"
                    xcopy /E /I /Y src\\public        "%APP_DIR%\\public"
                    copy /Y        src\\package.json       "%APP_DIR%\\package.json"
                    copy /Y        src\\package-lock.json  "%APP_DIR%\\package-lock.json"
                    copy /Y        src\\.env.production    "%APP_DIR%\\.env.production"
                    copy /Y        src\\next.config.*      "%APP_DIR%\\" 2>nul || echo no next.config found
                """
                // ติดตั้ง dependencies ที่ปลายทางโดยตรง (เร็วกว่า xcopy node_modules มาก)
                bat """
                    cd /d "%APP_DIR%" && npm ci --production
                """

                // Delete แล้ว Start ใหม่เสมอ เพื่อให้ PORT จาก .env.production ถูก apply ทุก deploy
                powershell """
                    \$port = (Get-Content "\$env:APP_DIR\\.env.production" |
                        Where-Object { \$_ -match '^PORT=' }) -replace '^PORT=', ''
                    pm2 delete \$env:APP_NAME 2>&1 | Out-Null
                    \$env:PORT = \$port
                    pm2 start "\$env:APP_DIR\\node_modules\\next\\dist\\bin\\next" --name \$env:APP_NAME --cwd "\$env:APP_DIR" --log "\$env:APP_DIR\\logs\\app.log" -- start
                    pm2 save
                """
                echo "Frontend deployed → http://localhost"
            }
        }
    }

    post {
        success {
            echo "✅ Deployment successful → http://localhost"
        }
        failure {
            echo "❌ Pipeline failed — check the stage logs above."
        }
        always {
            cleanWs()
        }
    }
}
